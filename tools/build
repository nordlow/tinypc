#!/usr/bin/env python3
"""Generate a build.ninja for Tiny Poly Compiler (parallel to the Makefiles).

Usage:
    tools/build [--builddir DIR] [--source DIR]
"""
import argparse
import json
import os
import subprocess

DEFAULT_CC = os.environ.get("CC", "cc")
DEFAULT_CFLAGS = os.environ.get("CFLAGS", "-O2 -g")
DEFAULT_LDFLAGS = os.environ.get("LDFLAGS", "")
DEFAULT_LIBS = os.environ.get("LIBS", "-lm -ldl -lpthread")
DEFAULT_AR = os.environ.get("AR", "ar")

LIBFILES = ["libtcc1.c", "stdatomic.c", "atomic.S", "builtin.c",
            "alloca.S", "alloca-bt.S", "tcov.c", "va_list.c",
            "dsohandle.c", "runmain.c"]


def guarded(limit, command):
    """Wrap a long, potentially hanging command in a timeout."""
    command = command.replace('"', '\\"')
    return ("timeout -k 5 %d sh -c \"%s\" </dev/null || "
            "{ rc=$$?; case $$rc in 124|137) echo TIMEOUT;; esac; "
            "exit $$rc; }" % (limit, command))


def read_config_mak(srcdir):
    """Read the simple KEY=VALUE pairs written by configure."""
    config = {}
    path = os.path.join(srcdir, "config.mak")
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                config[key] = value
    except FileNotFoundError:
        pass
    return config


def read_config_h(srcdir):
    """Read the simple #define lines written by configure."""
    macros = {}
    path = os.path.join(srcdir, "config.h")
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line.startswith("#define "):
                    continue
                parts = line.split(None, 2)
                if len(parts) < 2:
                    continue
                macros[parts[1]] = parts[2] if len(parts) > 2 else "1"
    except FileNotFoundError:
        pass
    return macros


def write_json(path, data):
    """Write stable, sorted JSON so diffs are meaningful."""
    with open(path, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")


def write_config_json(path, config, macros, cc, cflags, defs, src, bld):
    features = {}
    for key, value in config.items():
        if key.startswith("CONFIG_"):
            features[key] = value
    for key, value in macros.items():
        if key.startswith("CONFIG_"):
            features.setdefault(key, value)
    write_json(path, {
        "build": {
            "builddir": bld,
            "cc": cc,
            "cflags": cflags,
            "defines": defs,
            "source": src,
        },
        "features": features,
        "macros": macros,
        "target": {
            "arch": config.get("ARCH", ""),
            "build_os": config.get("BUILDOS", ""),
            "os": config.get("TARGETOS", ""),
            "version": config.get("VERSION", ""),
        },
    })


def git_hash(srcdir):
    try:
        ref = subprocess.check_output(
            ["git", "-C", srcdir, "rev-parse", "--abbrev-ref", "HEAD"],
            stderr=subprocess.DEVNULL, text=True).strip()
        log = subprocess.check_output(
            ["git", "-C", srcdir, "log", "-1", "--date=short",
             "--pretty=format:%cd " + ref + "@%h"],
            stderr=subprocess.DEVNULL, text=True).strip()
        diff = subprocess.run(
            ["git", "-C", srcdir, "diff", "--quiet"],
            stderr=subprocess.DEVNULL).returncode
        if diff != 0:
            log += "*"
        return log
    except Exception:
        return "unknown"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--builddir", default="build")
    ap.add_argument("--source", default=".")
    args = ap.parse_args()

    src = os.path.abspath(args.source)
    bld = os.path.abspath(args.builddir)
    os.makedirs(bld, exist_ok=True)

    config = read_config_mak(src)
    cc = os.environ.get("CC", config.get("CC", DEFAULT_CC))
    cflags = os.environ.get("CFLAGS", config.get("CFLAGS", DEFAULT_CFLAGS))
    ldflags = os.environ.get("LDFLAGS", config.get("LDFLAGS", DEFAULT_LDFLAGS))
    libs = os.environ.get("LIBS", DEFAULT_LIBS)
    ar = os.environ.get("AR", config.get("AR", DEFAULT_AR))

    ghash = git_hash(src)
    # Single-quote the define so the revision string survives the shell
    # even when it contains a space (for example "2026-11-04 dev@abc").
    defs = "-DONE_SOURCE=0 -DTCC_GITHASH='\"%s\"'" % ghash
    tcc_bin = os.path.join(bld, "tcc")
    full_cflags = "%s %s %s -I%s -I%s -I%s/include" % (cflags, defs,
                                                       "-std=gnu11", src, bld,
                                                       src)
    compdb = []

    L = []
    L.append("# Generated by tools/build - do not edit by hand.")
    L.append("builddir = %s" % bld)
    L.append("cc = %s" % cc)
    L.append("ar = %s" % ar)
    L.append("cflags = %s" % full_cflags)
    L.append("ldflags = %s" % ldflags)
    L.append("libs = %s" % libs)
    L.append("xflags = -B%s -I%s -I%s" % (src, src, bld))
    L.append("")
    L.append("rule cc")
    L.append("  command = $cc -o $out -c $in $cflags -MMD -MF $out.d")
    L.append("  depfile = $out.d")
    L.append("  deps = gcc")
    L.append("  description = CC $out")
    L.append("")
    L.append("rule tcc_cc")
    L.append("  command = %s -c $in -o $out $xflags" % tcc_bin)
    L.append("  description = TCC_CC $out")
    L.append("")
    L.append("rule link")
    L.append("  command = $cc -o $out $in $libs $ldflags")
    L.append("  description = LINK $out")
    L.append("")
    L.append("rule ar")
    L.append("  command = $ar rcs $out $in")
    L.append("  description = AR $out")
    L.append("")
    L.append("rule c2str")
    L.append("  command = $cc -DC2STR %s/conftest.c -o $out" % src)
    L.append("  description = C2STR $out")
    L.append("")
    L.append("rule gen_defs")
    L.append("  command = %s/c2str.exe %s/include/tccdefs.h $out" % (bld, src))
    L.append("  description = GEN $out")
    L.append("")
    L.append("rule regenerate")
    L.append("  command = cd %s && (python3 tools/build --builddir %s --source %s || python tools/build --builddir %s --source %s)" % (src, bld, src, bld, src))
    L.append("  description = REGEN build.ninja")
    L.append("  generator = 1")
    L.append("")

    L.append("build build.ninja: regenerate %s/tools/build %s/configure %s/config.mak %s/VERSION" % (src, src, src, src))
    L.append("")
    L.append("build %s/c2str.exe: c2str" % bld)
    L.append("")
    L.append("build %s/tccdefs_.h: gen_defs %s/c2str.exe %s/include/tccdefs.h" % (bld, bld, src))
    L.append("")
    L.append("rule show_config")
    L.append("  command = cat %s/config.json" % bld)
    L.append("  description = CONFIG")
    L.append("")
    L.append("build config: show_config | build.ninja")
    L.append("  phony = 1")
    L.append("")
    L.append("rule show_compdb")
    L.append("  command = cp %s/compile_commands.json %s/compile_commands.json && echo %s/compile_commands.json" % (bld, src, src))
    L.append("  description = COMPDB")
    L.append("")
    L.append("build compdb: show_compdb | build.ninja")
    L.append("  phony = 1")
    L.append("")

    # tccgen.c includes the tccgen-*.c fragments; the cc rule's depfile
    # tracks them, so there is no separate object for each fragment.
    libsrcs = ["libtcc.c", "tccpp.c", "tccgen.c", "tccdbg.c", "tccelf.c",
               "tccasm.c", "tccrun.c", "x86_64-gen.c", "x86_64-link.c",
               "i386-asm.c"]
    libobjs = []
    for fn in libsrcs:
        obj = os.path.join(bld, fn[:-2] + ".o")
        libobjs.append(obj)
        lib_cflags = "%s -fPIC -I%s -I%s -DONE_SOURCE=0" % (cflags, src, bld)
        L.append("build %s: cc %s/%s | %s/tccdefs_.h" % (obj, src, fn, bld))
        L.append("  cflags = %s" % lib_cflags)
        L.append("")
        compdb.append({
            "directory": src,
            "command": "%s -o %s -c %s/%s %s" % (cc, obj, src, fn,
                                                  lib_cflags),
            "file": os.path.join(src, fn),
        })
    L.append("build %s/libtcc.a: ar %s" % (bld, " ".join(libobjs)))
    L.append("")
    tcc_cflags = "%s %s -DONE_SOURCE=0 -I%s -I%s" % (cflags, defs, src, bld)
    L.append("build %s/tcc.o: cc %s/tcc.c | %s/tccdefs_.h %s/tcctools.c" % (bld, src, bld, src))
    L.append("  cflags = %s" % tcc_cflags)
    L.append("")
    compdb.append({
        "directory": src,
        "command": "%s -o %s/tcc.o -c %s/tcc.c %s" % (cc, bld, src,
                                                       tcc_cflags),
        "file": os.path.join(src, "tcc.c"),
    })
    L.append("build %s/tcc: link %s/tcc.o | %s/libtcc.a" % (bld, bld, bld))
    L.append("  libs = %s %s" % (libs, os.path.join(bld, "libtcc.a")))
    L.append("")

    libobjs = []
    for fn in LIBFILES:
        obj = os.path.join(bld, "lib_" + fn.rsplit(".", 1)[0] + ".o")
        libobjs.append(obj)
        L.append("build %s: tcc_cc %s | %s" % (obj, os.path.join(src, "lib", fn), tcc_bin))
        L.append("")
        if fn.endswith(".c"):
            compdb.append({
                "directory": src,
                "command": "%s -o %s -c %s %s -I%s -I%s" %
                           (cc, obj, os.path.join(src, "lib", fn), cflags,
                            src, bld),
                "file": os.path.join(src, "lib", fn),
            })
    L.append("build %s/libtcc1.a: ar %s" % (bld, " ".join(libobjs)))
    L.append("")

    L.append("rule run_tests")
    L.append("  command = %s" % guarded(900, "make -C %s test" % src))
    L.append("  description = TEST")
    L.append("")
    L.append("rule make_symlinks")
    L.append("  command = cd %s && ln -sf build/tcc tcc && ln -sf build/libtcc1.a libtcc1.a && ln -sf build/lib_runmain.o runmain.o" % src)
    L.append("  description = SYMLINK")
    L.append("")
    L.append("build symlink: make_symlinks | %s/tcc %s/libtcc1.a %s/lib_runmain.o" % (bld, bld, bld))
    L.append("  phony = 1")
    L.append("")
    L.append("build test: run_tests | symlink")
    L.append("  phony = 1")
    L.append("")
    L.append("rule run_check")
    L.append("  command = %s" % guarded(900, "cd %s && make -j$$(nproc) >/dev/null 2>&1 && make -j$$(nproc) test >/dev/null 2>&1 && echo 'ALL TESTS PASSED' || (echo 'TESTS FAILED'; exit 1)" % src))
    L.append("  description = CHECK")
    L.append("  pool = console")
    L.append("")
    L.append("build check: run_check")
    L.append("  phony = 1")
    L.append("")
    L.append("rule run_one")
    L.append("  command = %s" % guarded(120, "make -C %s tests2.$$TEST" % src))
    L.append("  description = TEST-ONE")
    L.append("")
    L.append("build test-one: run_one | %s/tcc %s/libtcc1.a" % (bld, bld))
    L.append("  phony = 1")
    L.append("")
    L.append("rule run_make")
    L.append("  command = %s" % guarded(300, "make -C %s $TARGET" % src))
    L.append("  description = MAKE $TARGET")
    L.append("")
    # tcc_c: coverage-instrumented compiler (built by tcc itself)
    L.append("rule build_tcc_c")
    L.append("  command = %s -B%s -I%s -I%s -o $out -ftest-coverage $in %s" % (tcc_bin, src, src, bld, libs))
    L.append("  description = TCC-COV $out")
    L.append("")
    L.append("build %s/tcc_c: build_tcc_c %s/tcc.c | %s/tccdefs_.h" % (bld, src, bld))
    # tcov-test: run tests with TCC_LOCAL pointing at tcc_c
    L.append("rule run_tcov")
    L.append("  command = %s" % guarded(900, "make -C %s TCC_LOCAL=%s/tcc_c test" % (src, bld)))
    L.append("  description = TCOV-TEST")
    L.append("")
    L.append("build tcov-test: run_tcov | %s/tcc_c" % bld)
    L.append("  phony = 1")
    L.append("")
    for tgt in ("doc", "clean", "distclean", "stack-address-check"):
        L.append("build %s: run_make" % tgt)
        L.append("  TARGET = %s" % tgt)
        L.append("  phony = 1")
        L.append("")
    L.append("rule run_pgo")
    L.append("  command = %s" % guarded(1800, "make -C %s pgo PGO_CC=%s" % (src, os.environ.get("PGO_CC", "cc"))))
    L.append("  description = PGO")
    L.append("")
    L.append("build pgo: run_pgo")
    L.append("  phony = 1")
    L.append("")
    L.append("rule run_pgo_bench")
    L.append("  command = %s" % guarded(600, "make -C %s pgo-bench" % src))
    L.append("  description = PGO-BENCH")
    L.append("")
    L.append("build pgo-bench: run_pgo_bench | %s/tcc" % bld)
    L.append("  phony = 1")
    L.append("")
    L.append("rule run_sani")
    L.append("  command = %s" % guarded(1800, "make -C %s sani-test" % src))
    L.append("  description = SANI-TEST")
    L.append("")
    L.append("build sani: run_sani")
    L.append("  phony = 1")
    L.append("build sani-test: run_sani")
    L.append("  phony = 1")
    L.append("")
    L.append("rule run_sani_one")
    L.append("  command = %s" % guarded(300, "make -C %s sani-tests2.$$TEST" % src))
    L.append("  description = SANI-ONE")
    L.append("")
    L.append("build sani-one: run_sani_one")
    L.append("  phony = 1")
    L.append("")
    L.append("default %s/tcc %s/libtcc1.a" % (bld, bld))
    L.append("")

    out_path = os.path.join(bld, "build.ninja")
    with open(out_path, "w") as f:
        f.write("\n".join(L))
    write_config_json(os.path.join(bld, "config.json"),
                      config, read_config_h(src), cc, full_cflags,
                      defs, src, bld)
    write_json(os.path.join(bld, "compile_commands.json"), compdb)
    print("wrote", out_path)


if __name__ == "__main__":
    main()
